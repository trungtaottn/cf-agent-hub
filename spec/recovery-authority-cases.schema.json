{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "matching_target_resume": {
      "$ref": "urn:cf-agent-hub:recovery-command:1"
    },
    "rejections": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "command": true
        },
        "required": [
          "name",
          "field",
          "command"
        ]
      }
    }
  },
  "required": [
    "matching_target_resume",
    "rejections"
  ]
}
