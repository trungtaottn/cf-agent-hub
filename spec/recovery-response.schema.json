{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cf-agent-hub:recovery-response:1",
  "$defs": {
    "RecoveryReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "complete",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "passed": {
                "type": "boolean"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "name",
              "passed",
              "code"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "unresolved_effect_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "unresolved_effect_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_effect_ids_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "capture_id",
        "workspace_id",
        "status",
        "checks",
        "unresolved_effect_ids",
        "started_at",
        "ended_at",
        "unresolved_effect_count",
        "unresolved_effect_ids_complete"
      ],
      "additionalProperties": false,
      "$comment": "Unresolved effects are an immutable snapshot at ended_at. IDs are the first min(64, unresolved_effect_count) distinct IDs in SQLite BINARY order. The exact count covers every unresolved row; unresolved_effect_ids_complete is true exactly when the count equals list length. Consumers must reject inconsistent summaries. Resume independently counts current SQL and requires zero."
    },
    "ProbeReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "config_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schema_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "passed": {
                "type": "boolean"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "name",
              "passed",
              "code"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "workspace_id",
        "config_epoch",
        "schema_version",
        "checked_at",
        "checks"
      ],
      "additionalProperties": false
    },
    "ResumeReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "old_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "new_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "probe_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "resumed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "capture_id",
        "workspace_id",
        "authority_epoch",
        "old_generation",
        "new_generation",
        "probe_id",
        "resumed_at"
      ],
      "additionalProperties": false
    },
    "RecoveryJobProgress": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "operation": {
          "enum": [
            "capture",
            "restore",
            "verify"
          ]
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "running",
            "complete",
            "failed"
          ]
        },
        "phase": {
          "enum": [
            "capture_pages",
            "awaiting_chunks",
            "verify_pages",
            "hash_chunks",
            "overlay_authority",
            "complete",
            "failed"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "chunks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "rows",
            "chunks",
            "bytes"
          ],
          "additionalProperties": false
        },
        "pending_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_operation": {
          "enum": [
            "capture",
            "write-chunk",
            "verify",
            null
          ]
        },
        "next_chunk_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "urn:cf-agent-hub:recovery-manifest:1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "capture_id",
        "workspace_id",
        "operation",
        "authority_epoch",
        "state",
        "phase",
        "step",
        "counts",
        "pending_operation_id",
        "next_operation",
        "next_chunk_index",
        "receipt",
        "manifest"
      ],
      "additionalProperties": false
    },
    "ChunkMetadata": {
      "type": "object",
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "capture_id",
        "index",
        "sha256",
        "byte_size"
      ],
      "additionalProperties": false
    },
    "RecoveryArtifactTransferState": {
      "type": "object",
      "description": "Future V2 transfer checkpoint within bounded details_json. Not exposed or persisted by R1 runtime. Immutable inventory is retained once in manifest; pending refers to exactly one entry.",
      "properties": {
        "version": {
          "const": 2
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "phase": {
          "enum": [
            "capture_artifacts",
            "restore_artifacts",
            "verify_artifacts",
            "complete"
          ]
        },
        "pending": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
                },
                "object_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "recovery_object_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 768
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "operation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
                },
                "request_fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              },
              "required": [
                "artifact_id",
                "object_key",
                "recovery_object_key",
                "byte_size",
                "sha256",
                "operation_id",
                "request_fingerprint",
                "index"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "manifest_sha256",
        "artifact_index",
        "artifact_bytes",
        "phase",
        "pending"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RecoveryJobProgress"
    },
    {
      "$ref": "#/$defs/RecoveryReceipt"
    },
    {
      "$ref": "#/$defs/ProbeReceipt"
    },
    {
      "$ref": "#/$defs/ResumeReceipt"
    }
  ]
}
