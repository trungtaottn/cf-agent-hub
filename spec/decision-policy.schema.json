{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cf-agent-hub:decision-policy:1",
  "title": "R3 inactive decision policy contract",
  "description": "Optional structural deployment policy only; not an actor grant, and no product actions are enabled by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "expiry_seconds",
    "expiry_batch_limit",
    "actions"
  ],
  "properties": {
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiry_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiry_batch_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "schema_version",
          "schema_sha256",
          "reviewer_ids",
          "resource_kinds"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "schema_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "resource_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
