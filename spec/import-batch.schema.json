{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cf-agent-hub:import-batch:1",
  "title": "R2 import batch input contract",
  "description": "Strict shape of a completely valid import batch. Raw request bytes are separately limited to 65,536 before decoding. For partial rejection, validate ImportEnvelope first, then each ImportRow independently. Strict root failure alone must not reject a preview request. Shape validation grants no authority and does not resolve current references or duplicate external IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_namespace",
    "source_revision",
    "rows"
  ],
  "properties": {
    "source_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_revision": {
      "type": "string",
      "maxLength": 256
    },
    "rows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/ImportRow"
      }
    }
  },
  "$defs": {
    "ImportRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "source_updated_at",
        "title",
        "description",
        "project_id",
        "work_role_id",
        "source_state",
        "source_ref"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:[Zz]|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "work_role_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_state": {
          "type": "string",
          "maxLength": 64
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ],
          "description": "Inert provenance text. Never fetched or interpreted as executable authority."
        }
      }
    },
    "ImportEnvelope": {
      "description": "Closed envelope admission only; row validity is reported separately. Null, primitive and unknown-field rows are not silently accepted as valid ImportRows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_namespace",
        "source_revision",
        "rows"
      ],
      "properties": {
        "source_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision": {
          "type": "string",
          "maxLength": 256
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": true
        }
      }
    }
  }
}
