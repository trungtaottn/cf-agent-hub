{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected bootstrap verification bundle",
  "type": "object",
  "properties": {
    "contract_revision": {
      "const": "0.1"
    },
    "config_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "workspace_id",
          "credential_id",
          "token_sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "retired_credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retired_at_epoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "workspace_id",
          "credential_id",
          "agent_id",
          "token_sha256",
          "retired_at_epoch"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "auth": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "tag"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_revision",
    "config_epoch",
    "config_digest",
    "credentials",
    "retired_credentials",
    "auth"
  ],
  "additionalProperties": false
}
