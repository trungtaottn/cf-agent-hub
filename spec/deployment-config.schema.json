{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CF Agent Hub deployment configuration contract revision 0.1",
  "type": "object",
  "properties": {
    "contract_revision": {
      "const": "0.1"
    },
    "workspace_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "object_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          }
        },
        "required": [
          "workspace_id",
          "object_name"
        ],
        "additionalProperties": false
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "verified-oidc"
        },
        "issuer": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?:/[a-zA-Z0-9._~!$&\\x27()*+,;=:@%/-]*)?$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 9,
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^https://[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
          }
        }
      },
      "required": [
        "mode",
        "issuer",
        "audience",
        "allowed_origins"
      ],
      "additionalProperties": false
    },
    "static_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "workspace_id",
          "agent_id",
          "display_name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_revision",
    "workspace_catalog",
    "authentication",
    "static_participants"
  ],
  "additionalProperties": false
}
