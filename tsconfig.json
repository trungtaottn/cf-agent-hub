{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "test/**/*.ts",
    "*.config.ts",
    "worker-configuration.d.ts",
    "src/**/*.ts"
  ]
}