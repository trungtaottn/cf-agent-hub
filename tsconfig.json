{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "test/**/*.ts",
    "*.config.ts",
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "packages/client/**/*.ts",
    "packages/cli/**/*.ts"
  ],
  "exclude": [
    "test/auth/operator-gateway.test.ts",
    "workers/operator/**",
    "src/ui/app.ts",
    "src/ui/settings.ts",
    "src/ui/dom.ts",
    "test/recovery/operator-transport.test.ts",
    "test/recovery/r2-operator.test.ts",
    "src/ui/kanban.ts",
    "src/ui/task-detail.ts",
    "test/client/task-rendering.test.ts",
    "test/client/focus-restoration.test.ts",
    "src/ui/task-action-view.ts",
    "test/client/task-action-view.test.ts"
  ]
}
