{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/r2-platform-evidence.schema.json",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql_bytes",
        "chunks",
        "artifact_bytes",
        "artifact_count",
        "canonical_manifest_bytes"
      ],
      "properties": {
        "sql_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canonical_manifest_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "workload_id": {
      "enum": [
        "sql-boundary",
        "artifact-boundary",
        "combined-boundary",
        "over-limit"
      ]
    },
    "layer": {
      "enum": [
        "controller-full-flow",
        "manifest-validator"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "revision",
        "tree_sha256",
        "environment_id",
        "command_id",
        "observed_at",
        "observer_id",
        "record_sha256",
        "composition_sha256",
        "resolution",
        "plan",
        "workloads"
      ],
      "properties": {
        "type": {
          "const": "r2-platform"
        },
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observer_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolution": {
          "$ref": "#/$defs/artifact_ref"
        },
        "plan": {
          "$ref": "#/$defs/artifact_ref"
        },
        "workloads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "revision",
        "tree_sha256",
        "environment_id",
        "command_id",
        "observed_at",
        "observer_id",
        "record_sha256",
        "composition_sha256",
        "status",
        "source_id",
        "runtime_version",
        "configuration_sha256",
        "plan_record_sha256",
        "limit_kind",
        "worker_invocation_limit",
        "subrequest_limit",
        "applicability_record_sha256"
      ],
      "properties": {
        "type": {
          "const": "r2-platform-resolution"
        },
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observer_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pending",
            "qualified"
          ]
        },
        "source_id": {
          "const": "cloudflare-workers-limits"
        },
        "runtime_version": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limit_kind": {
          "enum": [
            "aggregate-chain",
            "depth"
          ]
        },
        "worker_invocation_limit": {
          "const": 32
        },
        "subrequest_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "applicability_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "revision",
        "tree_sha256",
        "environment_id",
        "command_id",
        "observed_at",
        "observer_id",
        "record_sha256",
        "composition_sha256",
        "reviewer_id",
        "resolution_sha256",
        "workloads"
      ],
      "properties": {
        "type": {
          "const": "r2-platform-plan"
        },
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observer_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "resolution_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workloads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input_sha256",
              "dimensions",
              "observation_layer",
              "expected_outcome"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/workload_id"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "dimensions": {
                "$ref": "#/$defs/dimensions"
              },
              "observation_layer": {
                "$ref": "#/$defs/layer"
              },
              "expected_outcome": {
                "enum": [
                  "completed",
                  "rejected"
                ]
              }
            }
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "revision",
        "tree_sha256",
        "environment_id",
        "command_id",
        "observed_at",
        "observer_id",
        "record_sha256",
        "composition_sha256",
        "id",
        "input_sha256",
        "dimensions",
        "observation_layer",
        "outcome",
        "stages",
        "peak_worker_invocations",
        "peak_subrequests",
        "peak_depth",
        "external_effects",
        "rejection_code",
        "http_status"
      ],
      "properties": {
        "type": {
          "const": "r2-platform-workload"
        },
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observer_id": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "id": {
          "$ref": "#/$defs/workload_id"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "observation_layer": {
          "$ref": "#/$defs/layer"
        },
        "outcome": {
          "enum": [
            "completed",
            "rejected"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "enum": [
              "capture",
              "restore",
              "remote-verify"
            ]
          },
          "minItems": 0,
          "maxItems": 3
        },
        "peak_worker_invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peak_subrequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peak_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "external_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejection_code": {
          "enum": [
            null,
            "RECOVERY_TOTAL_BYTES_LIMIT",
            "INVALID_RECOVERY_MANIFEST"
          ]
        },
        "http_status": {
          "const": null
        }
      }
    },
    "platform_subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "runtime_version",
            "configuration_sha256",
            "plan_record_sha256",
            "applicability_record_sha256"
          ],
          "properties": {
            "kind": {
              "const": "resolution"
            },
            "runtime_version": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 128
            },
            "configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "plan_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "applicability_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "resolution_sha256",
            "review_record_sha256"
          ],
          "properties": {
            "kind": {
              "const": "plan"
            },
            "resolution_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "review_record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "input_sha256",
            "dimensions",
            "observation_layer"
          ],
          "properties": {
            "kind": {
              "const": "workload"
            },
            "id": {
              "$ref": "#/$defs/workload_id"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dimensions": {
              "$ref": "#/$defs/dimensions"
            },
            "observation_layer": {
              "$ref": "#/$defs/layer"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/platform"
    },
    {
      "$ref": "#/$defs/resolution"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/workload"
    }
  ]
}
