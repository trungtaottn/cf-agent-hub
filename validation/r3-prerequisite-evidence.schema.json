{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/r3-prerequisite-evidence.schema.json",
  "title": "Partial R3 prerequisite consistency only, not release acceptance",
  "oneOf": [
    {
      "$ref": "#/$defs/root"
    },
    {
      "$ref": "#/$defs/producer"
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_size"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action_semantic_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "config_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "revision",
        "tree_sha256",
        "build_sha256",
        "lock_sha256",
        "policy_sha256",
        "action_schema_sha256",
        "action_semantic_revision",
        "schema_version",
        "environment_id",
        "workspace_id",
        "deployment_id",
        "config_epoch"
      ],
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "sdk_version",
        "configuration_sha256"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "round": {
          "const": "R3"
        },
        "stage": {
          "const": "prerequisites"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "byte_size",
              "mode"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2048
        },
        "source_bindings": {
          "type": "object",
          "properties": {
            "lock": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "policy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action_schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "lock",
            "policy",
            "action_schema"
          ],
          "additionalProperties": false
        },
        "build": {
          "$ref": "#/$defs/artifact"
        },
        "protocol_version": {
          "const": "2025-11-25"
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "operation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            },
            "required": [
              "name",
              "operation"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "family": {
                "enum": [
                  "composition",
                  "decision-domain",
                  "human-browser",
                  "native-parity",
                  "mcp-stdio",
                  "mcp-clients",
                  "recovery",
                  "independent-review",
                  "prior-round"
                ]
              },
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "id",
              "family",
              "artifact"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "format_version",
        "round",
        "stage",
        "release_id",
        "identity",
        "sources",
        "source_bindings",
        "build",
        "protocol_version",
        "clients",
        "tools",
        "producers"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "record_type": {
          "const": "r3-prerequisite-producer"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "family": {
          "enum": [
            "composition",
            "decision-domain",
            "human-browser",
            "native-parity",
            "mcp-stdio",
            "mcp-clients",
            "recovery",
            "independent-review",
            "prior-round"
          ]
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "client_inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "started_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ended_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provenance": {
          "enum": [
            "synthetic",
            "recorded"
          ]
        }
      },
      "required": [
        "format_version",
        "record_type",
        "id",
        "family",
        "case_ids",
        "identity",
        "client_inventory_sha256",
        "started_at",
        "ended_at",
        "exit_code",
        "selected_count",
        "passed_count",
        "failed_count",
        "skipped_count",
        "provenance"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "family": {
                "enum": [
                  "composition",
                  "decision-domain",
                  "human-browser",
                  "native-parity",
                  "mcp-stdio",
                  "mcp-clients",
                  "recovery",
                  "independent-review",
                  "prior-round"
                ]
              },
              "case_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "minItems": 0,
                "maxItems": 256
              }
            },
            "required": [
              "id",
              "family",
              "case_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "identity",
        "clients",
        "producers"
      ],
      "additionalProperties": false
    }
  }
}
