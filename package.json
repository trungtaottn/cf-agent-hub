{
  "name": "cf-agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.operator.json --noEmit && tsc -p tsconfig.operator-test.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p workers/recovery-anchor/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:ui": "playwright test",
    "check": "npm run verify:generated && npm run verify:artifact-bindings && npm run verify:anchor-bindings && npm run typecheck && npm run verify:r1-contract && npm test && npm run test:workers && npm run test:operator && npm run test:current-restore-operator && npm run test:anchor-store && npm run test:anchor-provider && npm run test:current-provider-operator && npm run test:deployment-verifier && npm run test:recovery-cli",
    "verify:r1-contract": "node scripts/verify-r1-contract.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "generate:config": "node scripts/generate-config-validators.mjs",
    "verify:generated": "node scripts/generate-config-validators.mjs --check && node scripts/generate-auth-contract.mjs --check && node scripts/generate-operator-contract.mjs --check",
    "generate:auth": "node scripts/generate-auth-contract.mjs",
    "test:operator": "vitest run --config vitest.operator.workers.config.ts",
    "test:current-restore-operator": "vitest run --config vitest.current-restore-operator.config.ts",
    "generate:operator": "node scripts/generate-operator-contract.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "check:runtime": "node scripts/check-runtime-boot.mjs",
    "verify:readiness": "node scripts/verify-readiness.mjs",
    "verify:deployment": "node scripts/verify-r1-deployment.mjs",
    "recover:workspace": "node scripts/recover-workspace.mjs",
    "test:deployment-verifier": "node --test test/deployment/verify-r1-deployment.test.mjs",
    "test:recovery-cli": "node --test test/cli/*.test.mjs",
    "verify:artifact-bindings": "node scripts/verify-artifact-bindings.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "verify:anchor-bindings": "node scripts/verify-anchor-bindings.mjs",
    "test:anchor-store": "vitest run --config workers/recovery-anchor/vitest.store.config.ts",
    "test:current-provider-operator": "vitest run --config vitest.current-provider-operator.config.ts",
    "test:anchor-provider": "vitest run --config vitest.anchor-provider.config.ts",
    "test:native:r2": "node scripts/test-native-r2.mjs",
    "test:native:r2:source": "node --test test/native-r2/*.test.mjs",
    "test:native:r2:observer-local": "node scripts/test-native-r2-observer-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  },
  "bin": {
    "cf-agent-hub": "dist/cli/agenthub.mjs"
  }
}
